# Server Settings
PROJECT_NAME="Book Summarizer & Query AI"
API_V1_STR="/api/v1"
PORT=8000

# Database Settings (PostgreSQL with pgvector)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/book_summarizer"

# JWT Authentication & Security
# Secret key used to sign JWT tokens (generate using: openssl rand -hex 32)
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM & Embeddings (Google Gemini API - Free Tier)
# Get your free key from: https://aistudio.google.com/
GOOGLE_API_KEY="your-google-gemini-api-key"
LLM_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="models/text-embedding-004"

# Observability (Optional - LangSmith free tracing)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="book-summarizer-agent"
